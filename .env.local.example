# --- NOVA / CloudIQ (src/app/api/chat/route.ts) ---
# API key issued from the CloudIQ admin dashboard (/admin -> create key).
# Without it the NOVA console renders but every request returns 503.
# Server-side only: it is never exposed to the browser, so do NOT prefix
# it with NEXT_PUBLIC_.
CLOUDIQ_API_KEY=

# Override only if you are pointing at a different CloudIQ deployment.
# Defaults to https://REDACTED-GATEWAY-HOST
CLOUDIQ_BASE_URL=

# Override only to pin a specific upstream model. Defaults to cloudiq-smart,
# CloudIQ's complexity-routing model with its own fallback chain.
CLOUDIQ_MODEL=

# --- Vercel Blob (Storage tab -> Create Database -> Blob) ---
# Required for idea submissions and honeypot logging to persist.
# Ensure "Development" is checked on the Blob store connection before
# running `vercel env pull`, or this stays empty locally.
BLOB_READ_WRITE_TOKEN=

# --- Honeypot (src/proxy.ts) ---
# Optional AWS canary token credentials served in the decoy .env file.
# Get a free pair from canarytokens.org to be alerted the moment a scraper
# tries to use them.
HONEYPOT_AWS_ACCESS_KEY_ID=
HONEYPOT_AWS_SECRET_ACCESS_KEY=
